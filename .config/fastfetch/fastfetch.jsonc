{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#ffffff",
      "2": "#cccccc",
      "3": "#ffffff"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#ffffff"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#ffffff"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#ffffff"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#cccccc"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#ffffff"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#d0d0d0"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
